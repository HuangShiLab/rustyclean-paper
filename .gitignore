# macOS
.DS_Store

# Temporary / swap files
~$*
*.tmp
*.swp
*.swo

# Python environments
.venv_docx/
minimal_env/
__pycache__/
*.pyc

# Large binaries / installers
*.pkg
*.dmg
*.exe

# Large Office documents (keep Markdown sources)
*.docx

# Large generated data files
*.fastq
*.fastq.gz
*.fna
*.fna.gz
*.fa
*.fa.gz

# Large ground-truth / label files
ground_truth_labels.txt

# Runtime output directories (generated on HPC)
/data/simulated/
/data/enhanced/
/data/results/
/data/analysis/
/results/
/scripts/minimal/data/
/scripts/minimal/results/

# Cargo build artifacts for local rustyclean copies
/scripts/rustyclean_src/target/
target/

# Local RustyClean source copies that belong to the rustyclean repo, not this paper repo
/scripts/rustyclean_src/*.rs
pipeline.rs

# Accidental empty tool marker files
bowtie2,
kraken2,
minimap2,

# HPC job logs and monitor logs that are not part of the repo
*.out
*.err
logs/monitor_*.log

# Run outputs. These are hundreds of GB and must never enter the repository.
runs/
# Simulated reads and per-experiment results. Only the metadata is small enough
# to commit by accident, and doing so records a dataset's properties without the
# dataset -- which is how 15 empty datasets came to be described in the repo as
# though they held reads.
scratch/
data/*
!data/.gitkeep
figures/*
!figures/.gitkeep
.conda_envs/
